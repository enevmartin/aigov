---
import Base from "../layouts/Base.astro";
import IndicatorBoard from "../components/IndicatorBoard.astro";
import {
  allPublications,
  initials,
  loadCabinet,
  loadIndex,
  loadIndicators,
  loadLatest,
  ministryName,
  publicationsOfType,
  type Publication,
} from "../lib/published";

const index = loadIndex();
const cabinet = loadCabinet(index).map((member) => ({
  ...member,
  latest: loadLatest(index, member.slug),
}));
const active = cabinet.filter((m) => m.enabled || m.latest);
const preparing = cabinet.filter((m) => !m.enabled && !m.latest);

// --- Bulgaria in data: the tier-1 indicators of every active ministry -------
const indicators = active.flatMap((m) => loadIndicators(m.slug));
const nameOf = (id: string): string | null => ministryName(index, id.split(".")[0]!);

// --- analyses of official documents (tier 2) --------------------------------
const documentAnalyses = publicationsOfType(index, "event_analysis").slice(0, 6);

// --- active crisis briefs (visible, not sensational) ----------------------
const recentPubs: Publication[] = active.flatMap((m) => allPublications(index, m.slug));
const crisisBriefs = recentPubs
  .filter((p) => p.type === "crisis_brief" && p.report)
  .slice(0, 3);

// --- latest data analyses ----------------------------------------------------
const latestReports = recentPubs
  .filter((p) => p.report && !["crisis_brief", "event_analysis"].includes(p.type))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);
---

<Base title="България в данни" banner={true}>
  <h1>България в данни</h1>
  <p class="lead">
    Състоянието на държавата по ОФИЦИАЛНИ данни — НСИ, БНБ, Евростат, МФ и
    официални документи. Числата се изчисляват от програмен код директно от
    първоизточника; AI министрите само ги тълкуват, с цитиран източник.
  </p>

  {crisisBriefs.length > 0 && (
    <section class="crisis-band" aria-label="Извънредни брифинги">
      {crisisBriefs.map((brief) => (
        <a class="crisis-item" href={`/${brief.slug}/${brief.date}/`}>
          <span class="tag crisis-tag">Извънреден брифинг</span>
          <span class="crisis-title">{brief.report!.title}</span>
          <span class="muted">{ministryName(index, brief.slug)} · {brief.date}</span>
        </a>
      ))}
    </section>
  )}

  <section aria-labelledby="data-title">
    <h2 id="data-title" class="section-title">Ключови индикатори</h2>
    <IndicatorBoard indicators={indicators} ministryLabel={nameOf} />
  </section>

  <section aria-labelledby="docs-title">
    <h2 id="docs-title" class="section-title">Анализи на официални документи</h2>
    {documentAnalyses.length === 0 ? (
      <div class="card"><p class="muted">Още няма анализирани официални документи.</p></div>
    ) : (
      <div class="reports-grid">
        {documentAnalyses.map((pub) => (
          <a class="card report-card" href={`/${pub.slug}/${pub.date}/`}>
            <span class="muted report-meta">
              {ministryName(index, pub.slug)} · {pub.date}
            </span>
            <span class="report-title">{pub.report!.title}</span>
            <span class="muted report-summary">{pub.report!.summary}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  {latestReports.length > 0 && (
    <section aria-labelledby="latest-title">
      <h2 id="latest-title" class="section-title">Последни анализи на данните</h2>
      <div class="reports-grid">
        {latestReports.map((pub) => (
          <a class="card report-card" href={`/${pub.slug}/${pub.date}/`}>
            <span class="muted report-meta">
              {ministryName(index, pub.slug)} · {pub.date}
            </span>
            <span class="report-title">{pub.report!.title}</span>
            <span class="muted report-summary">{pub.report!.summary}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <h2 class="section-title">Кабинетът</h2>
  {cabinet.length === 0 && (
    <div class="card">
      <p class="muted">Още няма публикувани отчети. Кабинетът заседава скоро.</p>
    </div>
  )}
  <div class="cabinet-grid">
    {active.map((member) => (
      <a class="card minister-card" href={`/${member.slug}/`}>
        <div class="avatar" aria-hidden="true">{initials(member.name)}</div>
        <div class="minister-info">
          <h3>{member.name}</h3>
          {member.persona && (
            <p class="persona muted">AI министър „{member.persona}"</p>
          )}
          {member.latest?.report ? (
            <span class="tag">Отчет от {member.latest.date}</span>
          ) : (
            <span class="tag preparing-tag">активен · очаква първи отчет</span>
          )}
        </div>
      </a>
    ))}
  </div>

  {preparing.length > 0 && (
    <>
      <h2 class="section-title">Подготвят се</h2>
      <p class="muted">
        Декларирани министерства с проверени източници, които още не са
        активирани.
      </p>
      <div class="cabinet-grid">
        {preparing.map((member) => (
          <div class="card minister-card inactive">
            <div class="avatar" aria-hidden="true">{initials(member.name)}</div>
            <div class="minister-info">
              <h3>{member.name}</h3>
              {member.persona && (
                <p class="persona muted">AI министър „{member.persona}"</p>
              )}
              <span class="tag preparing-tag">подготвя се</span>
            </div>
          </div>
        ))}
      </div>
    </>
  )}
</Base>

<style>
  .crisis-band {
    display: grid;
    gap: 10px;
    margin-bottom: 26px;
  }
  .crisis-item {
    display: flex;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
    text-decoration: none;
    color: inherit;
    background: var(--bad-bg);
    border: 1px solid var(--line);
    border-left: 3px solid var(--bad);
    border-radius: var(--radius);
    padding: 12px 16px;
    font-size: 14.5px;
  }
  .crisis-tag {
    background: transparent;
    color: var(--bad);
    padding: 0;
  }
  .crisis-title {
    font-weight: 600;
  }

  .kpi-band {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 36px;
  }
  .kpi {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: inherit;
    padding: 18px 20px;
  }
  .kpi:hover {
    border-color: var(--accent);
  }
  .kpi-metric {
    font-size: 13.5px;
    color: var(--muted);
  }
  .kpi-value {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.15;
  }
  .kpi-unit {
    font-size: 15px;
    color: var(--muted);
    margin-left: 4px;
  }
  .kpi-delta {
    font-size: 12.5px;
    color: var(--muted);
  }
  .kpi-delta.up {
    color: var(--bad);
  }
  .kpi-delta.down {
    color: var(--accent);
  }
  .kpi-ministry {
    font-size: 12.5px;
    margin-top: 6px;
  }

  .section-title {
    font-size: 22px;
    margin: 34px 0 14px;
  }
  .reports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .report-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
  }
  .report-card:hover {
    border-color: var(--accent);
  }
  .report-meta {
    font-size: 12.5px;
  }
  .report-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 17.5px;
    line-height: 1.35;
  }
  .report-summary {
    font-size: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cabinet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .minister-card {
    display: flex;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  a.minister-card:hover {
    border-color: var(--accent);
  }
  .minister-card.inactive {
    opacity: 0.72;
  }
  .avatar {
    flex: 0 0 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-contrast);
    display: grid;
    place-items: center;
    font-weight: 600;
    font-size: 17px;
  }
  .inactive .avatar {
    background: var(--muted);
  }
  .minister-info h3 {
    margin: 0 0 4px;
    font-size: 16.5px;
  }
  .persona {
    margin: 0 0 8px;
    font-size: 13px;
  }
  .preparing-tag {
    background: var(--surface-2);
    color: var(--muted);
  }
</style>
